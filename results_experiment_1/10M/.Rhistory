}
}
names(COF) <- c("nsj","Estimate","SE","df","t","p","singular")
COF$warn <- warn
COF$noWarn <- warn == ""
COF$sign <- as.numeric(COF$p < 0.05 & COF$Estimate > 0)
COF %>% group_by(nsj) %>% summarize(power = mean(sign))
p1 <- ggplot(data=COF)+
geom_smooth(aes(x=nsj, y=sign))+
geom_point(   stat="summary", aes(x=nsj, y=sign))+
geom_errorbar(stat="summary", aes(x=nsj, y=sign))+
geom_line(    stat="summary", aes(x=nsj, y=sign))
p1
# determine number of subjects needed for a power of 80%
m0 <- loess(sign ~ nsj, data=COF)
COF$pred <- predict(m0)
idx <- COF$pred>0.8
min(COF$nsj[idx])
